# Copy to .env and fill in your Supabase project's values
# (Supabase Dashboard -> Project Settings -> API).
#
# This is the browser-facing anon/publishable key -- it is safe to expose in
# client code (that's what it's for), but Row Level Security is what
# actually protects the data behind it. Never put a service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Do NOT add dev-login bypass credentials here. Sign in for local development
# the same way a real student would: request a magic link and click it (or
# read the link straight out of Supabase Auth logs / Inbucket in local dev).
